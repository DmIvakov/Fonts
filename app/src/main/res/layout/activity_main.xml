<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_margin="20dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textViewTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Właściwości czcionki"
        android:background="#558B2F"
        android:textColor="@color/white"
        android:textSize="13pt"
        android:textStyle="bold"
        android:layout_marginBottom="40dp" />

    <LinearLayout
        android:id="@+id/linearLayoutFontSize"
        android:layout_width="wrap_content"
        android:orientation="horizontal"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp" >

        <TextView
            android:id="@+id/textViewFontSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="10pt"
            android:text="Rozmiar: " />

        <TextView
            android:id="@+id/textViewFontSizeValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="10pt"
            android:text="20" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/seekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:min="0"
        android:max="40"
        android:progress="20"
        android:thumbTint="#00BCD4"
        android:progressTint="#00BCD4"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/textViewString"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"/>

    <Button
        android:id="@+id/btnNext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:backgroundTint="#558B2F"
        android:textColor="@color/white"
        android:text=">>"
        android:textStyle="bold"
        app:cornerRadius="1dp" />
</LinearLayout>